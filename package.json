{
  "name": "pickleball-league",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "kysely migrate latest",
    "db:migrate:down": "kysely migrate down",
    "db:types": "kysely-codegen --dialect postgres --date-parser string --out-file src/db/types.ts && prettier --write src/db/types.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "kysely": "^0.29.8",
    "kysely-neon": "^3.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@next/env": "^16.4.6",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.22.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
